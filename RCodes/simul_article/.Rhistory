X <- vector("list", K)
Xs <- vector("list", K)
normX<-rep(NA,K)
for(k in seq_len(K)) {
E <- matrix(rnorm(N * P[k], 0, sigma[j]), nrow = N, ncol = P[k])
V[[k]]<-orth(P[k],R)
X[[k]] <- U0 %*% diag(Sigma[[k]]) %*% t(V[[k]]) + E
X[[k]] <- scale(X[[k]], center = TRUE, scale = FALSE)
normX[k] <- norm(X[[k]], "F")
Xs[[k]] <- X[[k]] #/ normX[k]
}
m2<-omcoa_als(Xs,R)
chains <- lapply(1:4, function(c) { set.seed(c)
gibbs_sparse_omcoa(X, R = 4, n_iter = 6000, burn = 2000,
init_gamma = if (c <= 2) "all" else "none", verbose = FALSE) })
dg <- mcmc_diagnostics(chains, U_ref = m2$U)
diagnostic[[j]] <- dg
}
#save(diagnostic,file="diagnostic.RData")
res_diag<-data.frame(matrix(NA,nrow=length(sigma),ncol=10))
for(j in 1:length(sigma)){
D<-diagnostic[[j]]
res_diag[j,]<-c(sigma[j],D$reff$rhat,D$reff$max_diff,round(D$reff$ess_bulk),max(D$sigma$rhat),D$sigma[which.max(D$sigma$rhat),1:2],round(min(D$sigm$ess_bulk)),D$sigma[which.min(D$sigm$ess_bulk),1:2])
}
colnames(res_diag)<-c("sigma","Rhat(Reff)","Max Diff P(Reff=j)","ess_bulk(Reff)","Max (Rhat(sigma)","block","dim","Min ess_bulk(sigma)","block","dim")
res_diag
library(xtable)
tab<-xtable(res_diag)
print(tab,include.rownames = FALSE)
