orth <- function(n, h) qr.Q(qr(matrix(rnorm(n * h), n, h)))
Sigma=list(sig_true[1,],sig_true[2,],sig_true[3,])
orth <- function(n, h) qr.Q(qr(scale(matrix(rnorm(n * h), n, h), scale = FALSE)))
U0 <- orth(N,H)
V <- vector("list", K)
X <- vector("list", K)
Xs <- vector("list", K)
normX<-rep(NA,K)
for(k in seq_len(K)){
E <- matrix(rnorm(N * P[k], 0, sigma[j]), nrow = N, ncol = P[k])
V[[k]]<-orth(P[k],H)
X[[k]] <- U0 %*% diag(Sigma[[k]]) %*% t(V[[k]]) + E
X[[k]] <- scale(X[[k]], center = TRUE, scale = FALSE)
normX[k] <- norm(X[[k]], "F")
Xs[[k]] <- X[[k]] / normX[k]
}
sigma<-0
for(k in seq_len(K)){
E <- matrix(rnorm(N * P[k], 0, sigma), nrow = N, ncol = P[k])
V[[k]]<-orth(P[k],H)
X[[k]] <- U0 %*% diag(Sigma[[k]]) %*% t(V[[k]]) + E
X[[k]] <- scale(X[[k]], center = TRUE, scale = FALSE)
normX[k] <- norm(X[[k]], "F")
Xs[[k]] <- X[[k]] / normX[k]
}
m0 <- mcoa(Xs,H)
apply(m0$U,2,function(x) norm(as.matrix(x),"F"))
apply(m0$V[[1]],2,function(x) norm(as.matrix(x),"F"))
SIG<-align_solution(U=m0$U,V = m0$V,sigma = m0$S,U_ref=U0)$sigma
SIG<-align_solution(U=m0$U,V = m0$V,S = m0$S,U_ref=U0)$sigma
SIG
