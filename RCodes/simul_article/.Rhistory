library(BayesCanoFacto)
N <- 100; P <- c(10, 5, 15); R <- 4; K <- 3
sig_true <- rbind(c(.7, .5,0 ,0), c(.5, .7, 0,0), c(.3,0, .5,0))
Sigma=list(sig_true[1,],sig_true[2,],sig_true[3,])
orth <- function(n, h) qr.Q(qr(scale(matrix(rnorm(n * h), n, h), scale = FALSE)))
sigma<-c(0.04,0.06,0.08,0.12)
diagnostic<-list()
for(j in 1:length(sigma)){
U0 <- orth(N,R)
V <- vector("list", K)
X <- vector("list", K)
Xs <- vector("list", K)
normX<-rep(NA,K)
for(k in seq_len(K)) {
E <- matrix(rnorm(N * P[k], 0, sigma[j]), nrow = N, ncol = P[k])
V[[k]]<-orth(P[k],R)
X[[k]] <- U0 %*% diag(Sigma[[k]]) %*% t(V[[k]]) + E
X[[k]] <- scale(X[[k]], center = TRUE, scale = FALSE)
normX[k] <- norm(X[[k]], "F")
Xs[[k]] <- X[[k]] #/ normX[k]
}
m2<-omcoa_als(Xs,R)
chains <- lapply(1:4, function(c) { set.seed(c)
gibbs_sparse_omcoa(X, R = 4, n_iter = 6000, burn = 2000,
init_gamma = if (c <= 2) "all" else "none", verbose = FALSE) })
dg <- mcmc_diagnostics(chains, U_ref = fit_omcoa$U)
diagnostic[[j]] <- dg
}
