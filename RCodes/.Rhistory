data<-read_excel("~/Dropbox/Rita_Bitar/data2.xlsx")
data$Sexe<-as.factor(data$Sexe)
data$Congeneres<-as.numeric(data$Congeneres)
data$Mode_vie<-factor(data$Mode_vie,levels=c("m","a"))
data$Balcon_jardin<-factor(data$Balcon_jardin,levels=c("b","j","0"))
data$Age_apparit<-as.numeric(data$Age_apparit)
data$Freq_dehors<-as.numeric(data$Freq_dehors)
data$Sortie<-as.numeric(data$Sortie)
data$Alimentation<-factor(data$Alimentation,levels=c("c","m"))
data$Marque<-factor(data$Marque,levels=c("v","a"))
data$Vaccination<-as.numeric(data$Vaccination)
data$Type_prurit<-factor(data$Type_prurit,levels=c("p","s"))
data$Intensite<-factor(data$Intensite,levels=c("f","i","m"))
data$freq_max<-as.numeric(data$freq_max)
summary(data)
data2<-na.omit(data[data$Type!="SCAF",colnames(data)[c(2,3,5,6,9,10,12,13,17:20,22:25,29,30,33,40,41,42,44,45,49,50,52,53,54,56,60)]])
dim(data2)
data2$Type<-as.numeric(data2$Type=="HNIP")
set.seed(33)
train<-sample(1:dim(data2)[1],size=dim(data2)[1]*2/3)
training<-data2[train,]
table(training$Type)
model<-glm(Type~.,data=training)
summary(model)
tab<-table(as.numeric(predict(model,type="response")>.5),training$Type)
print("Specificity")
tab[1,1]/sum(tab[,1])
print("Sensitivity")
tab[2,2]/sum(tab[,2])
test<-data2[-train,]
table(test$Type)
tab<-table(as.numeric(predict(model,newdata = test,type="response")>.5),test$Type)
