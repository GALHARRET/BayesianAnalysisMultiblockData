summary_sigma_freq<-function(out){
K<-dim(out)[1]
H<-dim(out)[2]
block<-NULL
for(k in 1:K) block<-c(block,rep(k,H))
SIG<-as.vector(t(out))
res<-as.data.frame(matrix(NA,ncol=3,nrow=length(SIG)))
colnames(res)<-c("block","dim","estimate")
res$block<-block
res$dim<-rep(1:H,K)
res$estimate<-SIG
return(res)
}
