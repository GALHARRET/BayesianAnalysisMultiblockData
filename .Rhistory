algoMCOAv=function(X,R=2){
N<-dim(X[[1]])[1]
K<-length(X)
XX=ade4::ktab.list.dudi(lapply(X, function(x) ade4::dudi.pca(as.data.frame(x), scale = FALSE, scannf = FALSE, nf = R)))
res=ade4::mcoa(XX, scannf = FALSE, nf = R,option = "uniform")
U=as.matrix(res$SynVar)/sqrt(N)
V<-list()
SIG<-list()
for(k in 1:K){
V[[k]]=t(X[[k]])%*%U
SIG[[k]]=sqrt(diag(t(U)%*%X[[k]]%*%V[[k]]))
}
return(list(U=as.matrix(res$SynVar)/sqrt(N),SIG=SIG,V=V))
}
library(BayesCanoFacto)
N <- 100; P <- c(10, 5, 15); H <- 3; K <- 3
sig_true <- rbind(c(.7, .5,.3), c(.5, .3,.7), c(.3,.7,.5))
orth <- function(n, h) qr.Q(qr(matrix(rnorm(n * h), n, h)))
U0 <- qr.Q(qr(scale(matrix(rnorm(N * H), N, H), scale = FALSE)))
Es <- vector("list", K)
sigma<-0
Xs <- lapply(seq_len(K), function(k) {
S <- U0 %*% diag(sig_true[k, ]) %*% t(orth(P[k], H))
E <- scale(matrix(rnorm(N * P[k]), N, P[k]), scale = FALSE)
Es[[k]] <<- E * sqrt(sigma / 0.90 * sum(S^2) / sum(E^2))
S + Es[[k]]
})
m0 <- mcoa(Xs,H)
apply(m0$U,2,function(x) norm(as.matrix(x),"F"))
SIG<-align_solution(U=m0$U,V = m0$V,sigma = m0$S,U_ref=U0)$sigma
summary_sigma_freq(SIG)
m1 <- algoMCOAv(Xs,H)
apply(m1$U,2,function(x) norm(as.matrix(x),"F"))
SIG<-align_solution(U=m1$U,V = m1$V,sigma = m1$S,U_ref=U0)$sigma
summary_sigma_freq(SIG)
m2<-omcoa_als(Xs,H)
SIG<-align_solution(U=m2$U,V = m2$V,sigma = m2$S,U_ref=U0)$sigma
summary_sigma_freq(SIG)
dr <- gibbs_omcoa(Xs, H, n_iter = 2000, burn = 1000)
dr <- align_draws(dr, U0)
summary_sigma(dr)
dr <- gibbs_omcoa(Xs, H, n_iter = 10000, burn = 5000)
dr <- align_draws(dr, U0)
summary_sigma(dr)
library(BayesCanoFacto)
N <- 100; P <- c(10, 5, 15); H <- 5; K <- 3
sig_true <- rbind(c(.7, .5, .3,0,0), c(.5, .3, .7,0,0), c(.3, .7, .5,0,0))
orth <- function(n, h) qr.Q(qr(matrix(rnorm(n * h), n, h)))
sigma<-c(0.02,0.04,0.06,0.08,0.12,0.16,0.18,0.20,0.22)
U0 <- orth(N,H)
V <- vector("list", K)
X <- vector("list", K)
Xs <- vector("list", K)
normX<-rep(NA,K)
Sigma=list(sig_true[1,],sig_true[2,],sig_true[3,])
j<-1
for(k in seq_len(K)) {
E <- matrix(rnorm(N * P[k], 0, sigma[j]), nrow = N, ncol = P[k])
V[[k]]<-orth(P[k],H)
X[[k]] <- U0 %*% diag(Sigma[[k]]) %*% t(V[[k]]) + E
X[[k]] <- scale(X[[k]], center = TRUE, scale = FALSE)
normX[k] <- norm(X[[k]], "F")
Xs[[k]] <- X[[k]] / normX[k]
}
Y<-cbind(Xs[[1]],Xs[[2]],Xs[[3]])
fit <- hoff_svd(Y, Rmax = 5, n_iter = 3000, burn = 500, center = TRUE)
gd_threshold(Y, center = TRUE)$rank
gd_threshold(Y, center = TRUE)
fit <- hoff_svd(Y, Rmax = 5, n_iter = 1000, burn = 500, center = TRUE)
K<-3;H<-5
